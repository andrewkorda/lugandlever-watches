FROM node:22-alpine
WORKDIR /app

# Cache package installation
COPY package.json package-lock.json ./
RUN npm ci

# Copy the rest of the application files
COPY . .

EXPOSE 3000

# Start Vite dev server on 0.0.0.0 so Docker can map the port
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]